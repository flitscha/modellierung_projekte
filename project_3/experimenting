def naca4(m_pct, p_pct, t_pct, n=200):
    m = m_pct / 100.0
    p = p_pct / 10.0
    t = t_pct / 100.0
    beta = np.linspace(0, np.pi, n)
    x = 0.5 * (1 - np.cos(beta))
    yt = 5*t*(0.2969*np.sqrt(x) - 0.1260*x - 0.3516*x**2 + 0.2843*x**3 - 0.1015*x**4)
    if p == 0 or m == 0:
        yc = np.zeros_like(x)
        dyc_dx = np.zeros_like(x)
    else:
        yc = np.where(x <= p,
                      (m/p**2)*(2*p*x - x**2),
                      (m/(1-p)**2)*((1-2*p) + 2*p*x - x**2))
        dyc_dx = np.where(x <= p,
                          (2*m/p**2)*(p - x),
                          (2*m/(1-p)**2)*(p - x))
    theta = np.arctan(dyc_dx)
    xu = x - yt*np.sin(theta);  yu = yc + yt*np.cos(theta)
    xl = x + yt*np.sin(theta);  yl = yc - yt*np.cos(theta)
    return xu, yu, xl, yl, x, yc


def cst_profile(Au, Al, n=200):
    from math import comb
    x = 0.5*(1 - np.cos(np.linspace(0, np.pi, n)))
    C = np.sqrt(x)*(1 - x)
    def shape(A):
        N = len(A) - 1
        S = np.zeros_like(x)
        for i, a in enumerate(A):
            S += a * comb(N, i) * (x**i) * ((1-x)**(N-i))
        return S
    return x, C*shape(Au), x, -C*shape(Al)


def save_selig(xu, yu, xl, yl, filename, name="AIRFOIL"):
    upper = np.column_stack([xu[::-1], yu[::-1]])
    lower = np.column_stack([xl[1:], yl[1:]])
    coords = np.vstack([upper, lower])
    with open(filename, "w") as f:
        f.write(f"{name}\n")
        for xi, yi in coords:
            f.write(f"  {xi:.6f}  {yi:.6f}\n")
    print(f"Gespeichert: {filename}  ({len(coords)} Punkte)")


def load_selig(filename):
    coords = []
    name = "Airfoil"
    with open(filename) as f:
        for i, line in enumerate(f):
            parts = line.split()
            if len(parts) == 2:
                try:
                    coords.append([float(parts[0]), float(parts[1])])
                except ValueError:
                    pass
            elif i == 0:
                name = line.strip()
    coords = np.array(coords)
    if np.linalg.norm(coords[0] - coords[-1]) > 1e-6:
        coords = np.vstack([coords, coords[0]])
    return coords[:, 0], coords[:, 1], name


def naca4_closed(m_pct=4, p_pct=4, t_pct=12, n=150):
    xu, yu, xl, yl, _, _ = naca4(m_pct, p_pct, t_pct, n)
    xp = np.concatenate([xu[::-1], xl[1:], [xu[-1]]])
    yp = np.concatenate([yu[::-1], yl[1:], [yu[-1]]])
    return xp, yp, f"NACA {m_pct}{p_pct}{t_pct:02d}"


def coords_to_closed(xu, yu, xl, yl):
    xp = np.concatenate([xu[::-1], xl[1:], [xu[-1]]])
    yp = np.concatenate([yu[::-1], yl[1:], [yu[-1]]])
    return xp, yp


