# CL-SWEEP
# ═══════════════════════════════════════════════════════════════

def run_cl_sweep(solver, name, alphas=None):
    if alphas is None:
        alphas = np.linspace(-8, 16, 25)
    CLs = []
    print(f"\nCL-Sweep für {name}:")
    for a in alphas:
        _, _, _, CL, _, _ = solver.solve(a)
        CLs.append(CL)
        print(f"  α = {a:6.1f}°  CL = {CL:+.4f}")
    CLs = np.array(CLs)
    mask = (alphas > -5) & (alphas < 12)
    coeffs = np.polyfit(np.deg2rad(alphas[mask]), CLs[mask], 1)
    slope = coeffs[0]
    aL0 = np.rad2deg(-coeffs[1] / coeffs[0])

    fig, ax = plt.subplots(figsize=(7, 5))
    fig.patch.set_facecolor("#f8f8f8")
    ax.set_facecolor("white")
    ax.plot(alphas, CLs, "o-", color="steelblue", linewidth=2,
            markersize=5, label="Panel-Methode")
    tat = 2*np.pi*(np.deg2rad(alphas) - np.deg2rad(aL0))
    ax.plot(alphas, tat, "--", color="tomato", linewidth=1.5,
            label=f"Dünnprofil-Th. (αL0 = {aL0:.1f}°)")
    ax.axhline(0, color="#aaa", linewidth=0.8)
    ax.axvline(0, color="#aaa", linewidth=0.8)
    ax.axvspan(0, 10, alpha=0.05, color="green")
    ax.grid(True, alpha=0.3, linewidth=0.5)
    ax.set_xlabel("Anstellwinkel α [°]", fontsize=10)
    ax.set_ylabel("Auftriebsbeiwert CL", fontsize=10)
    ax.set_title(f"CL(α) — {name}\ndCL/dα = {slope:.3f}  (2π = {2*np.pi:.3f})",
                 fontsize=10)
    ax.legend(fontsize=9)
    print(f"\n  dCL/dα = {slope:.4f}  (Theorie: {2*np.pi:.4f})")
    print(f"  αL0    = {aL0:.2f}°")
    plt.tight_layout()
    plt.show()


