# ABSCHNITT 11: PARAMETERSTUDIE (optional)
# =============================================================================
# Wir testen verschiedene Querschnittsdicken und Feldanzahlen
# um die optimale Kombination zu finden.

def parameter_study():
    """
    Testet verschiedene Kombinationen und gibt eine Übersicht aus.
    """
    print("\n" + "="*60)
    print("PARAMETERSTUDIE: Welche Konfiguration ist optimal?")
    print("="*60)
    print(f"{'N':>4} {'t_top':>6} {'t_bot':>6} {'t_d':>5} {'Defl':>7} {'Gew':>7} {'SF':>6} {'OK?':>6}")
    print("-"*55)
    
    results = []
    
    for N in [6, 8, 10]:
        for t_chord in [2.0, 2.5, 3.0]:
            for t_web in [1.0, 1.5, 2.0]:
                
                nodes   = build_nodes(N, L_mm, H_mm)
                members = build_members(N, nodes, t_chord, t_chord, t_web, t_web, truss_type)
                K       = build_stiffness_matrix(nodes, members, E_MPa)
                fixed, F = apply_boundary_conditions_and_load(
                               nodes, N, F_total_N, load_width, L_mm)
                
                try:
                    u = solve_system(K, F, fixed)
                    members = compute_member_forces(members, nodes, u, E_MPa)
                    
                    # Durchbiegung
                    deflections = [abs(u[2*(2*i+1)+1]) for i in range(N+1)]
                    defl = max(deflections)
                    
                    # Gewicht
                    vol  = sum(m['A'] * m['L'] for m in members)
                    wt   = vol * rho_g_mm3
                    
                    # Sicherheitsfaktor
                    max_s = max(abs(m['stress']) for m in members)
                    sf    = sigma_yield / max_s if max_s > 0 else 999
                    
                    ok = "✓" if defl <= max_deflection_mm and sf >= 1.5 else "✗"
                    
                    print(f"{N:>4} {t_chord:>6.1f} {t_chord:>6.1f} {t_web:>5.1f} "
                          f"{defl:>7.3f} {wt:>7.2f} {sf:>6.2f} {ok:>6}")
                    
                    if defl <= max_deflection_mm and sf >= 1.5:
                        results.append((wt, N, t_chord, t_web, defl, sf))
                
                except np.linalg.LinAlgError:
                    print(f"{N:>4} {t_chord:>6.1f} {t_chord:>6.1f} {t_web:>5.1f} SINGULAR")
    
    if results:
        results.sort()  # nach Gewicht sortieren
        best = results[0]
        print(f"\n  → Leichteste funktionierende Konfiguration:")
        print(f"     N={best[1]}, t_chord={best[2]:.1f} mm, t_web={best[3]:.1f} mm")
        print(f"     Durchbiegung: {best[4]:.3f} mm, Gewicht: {best[0]:.2f} g, SF: {best[5]:.2f}")
    else:
        print("\n  → Keine Konfiguration erfüllt alle Anforderungen!")
        print("    Größere Querschnitte oder andere Höhe versuchen.")


