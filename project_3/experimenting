    # Zurück-Button
    ax_back = fig.add_axes([0.03, 0.03, 0.10, 0.04])
    btn_back = Button(ax_back, "← Generator", color="#eaeaea", hovercolor="#d0d0d0")
    btn_back.label.set_fontsize(9)

    # CL-Sweep-Button
    ax_sweep = fig.add_axes([0.87, 0.03, 0.10, 0.04])
    btn_sweep = Button(ax_sweep, "CL(α)-Sweep", color="#ffe0b2", hovercolor="#ffcc80")
    btn_sweep.label.set_fontsize(9)

    title_obj = [None]

    # Colorbar-Handles merken um sie neu zu zeichnen
    cb_handles = {"cb1": None, "cb3": None}

    def draw(alpha_deg):
        print(f"  Löse Panel-System für α = {alpha_deg:.1f}° ...", end=" ", flush=True)
        sigma, gamma, Cp, CL, Gamma, ut = solver.solve(alpha_deg)
        print(f"CL = {CL:+.4f}")

        if title_obj[0] is not None:
            title_obj[0].set_text(
                f"Potentialströmung — {name}  |  α = {alpha_deg:.1f}°  |  "
                f"CL = {CL:.4f}  |  Γ = {Gamma:.4f}"
            )
        else:
            title_obj[0] = fig.suptitle(
                f"Potentialströmung — {name}  |  α = {alpha_deg:.1f}°  |  "
                f"CL = {CL:.4f}  |  Γ = {Gamma:.4f}",
                fontsize=11, color="#222"
            )

        norm = plt.Normalize(vmin=min(-1.0, Cp.min()), vmax=max(1.0, Cp.max()))

        # ── Ax1: Profil + Cp ──────────────────────────────────
        ax1.cla()
        ax1.set_facecolor("#f0f4fa")
        ax1.set_aspect("equal")
        ax1.set_title("Profil & Druckbeiwert Cp", fontsize=10)
        ax1.set_xlabel("x/c", fontsize=9)
        ax1.set_ylabel("y/c", fontsize=9)
        for i in range(solver.N):
            j = (i+1) % solver.N
            ax1.plot([solver.x[i], solver.x[j]], [solver.y[i], solver.y[j]],
                     color=cmap(norm(Cp[i])), linewidth=3)
        ax1.fill(solver.x, solver.y, alpha=0.08, color="steelblue")
        sm1 = plt.cm.ScalarMappable(cmap=cmap, norm=norm)
        sm1.set_array([])
        if cb_handles["cb1"] is not None:
            cb_handles["cb1"].remove()
        cb_handles["cb1"] = fig.colorbar(sm1, ax=ax1, shrink=0.8, pad=0.02)
        cb_handles["cb1"].set_label("Cp", fontsize=8)
        cb_handles["cb1"].ax.tick_params(labelsize=7)
        ax1.annotate("", xy=(solver.x.min()-0.05, 0),
                     xytext=(solver.x.min()-0.20, 0),
                     arrowprops=dict(arrowstyle="->", color="#444", linewidth=1.5))
        ax1.text(solver.x.min()-0.22, 0.02, f"V∞, α={alpha_deg:.0f}°",
                 fontsize=7, color="#444")

        # ── Ax2: Cp(x) ────────────────────────────────────────
        ax2.cla()
        ax2.set_facecolor("white")
        ax2.invert_yaxis()
        ax2.set_title("Druckverteilung Cp(x/c)", fontsize=10)
        ax2.set_xlabel("x/c", fontsize=9)
        ax2.set_ylabel("Cp", fontsize=9)
        ax2.grid(True, alpha=0.3, linewidth=0.5)
        u_mask = solver.ny > 0
        l_mask = solver.ny < 0
        xu_ = solver.xc[u_mask];  Cpu = Cp[u_mask];  iu = np.argsort(xu_)
        xl_ = solver.xc[l_mask];  Cpl = Cp[l_mask];  il = np.argsort(xl_)
        ax2.plot(xu_[iu], Cpu[iu], "b-o", markersize=3, linewidth=1.5, label="Oberseite")
        ax2.plot(xl_[il], Cpl[il], "r-o", markersize=3, linewidth=1.5, label="Unterseite")
        ax2.axhline(0, color="#aaa", linewidth=0.8, linestyle="--")
        ax2.fill_between(xu_[iu], Cpu[iu], 0, alpha=0.10, color="blue")
        ax2.fill_between(xl_[il], Cpl[il], 0, alpha=0.10, color="red")
        ax2.legend(fontsize=8)

        # ── Ax3: Stromlinien ──────────────────────────────────
        ax3.cla()
        ax3.set_facecolor("#e8f0f8")
        ax3.set_aspect("equal")
        ax3.set_title("Stromlinien & Geschwindigkeit |u|", fontsize=10)
        ax3.set_xlabel("x/c", fontsize=9)
        ax3.set_ylabel("y/c", fontsize=9)
        print("  Berechne Strömungsfeld ...", end=" ", flush=True)
        xg, yg, ug, vg = velocity_field(solver, sigma, gamma, alpha_deg, nx=50, ny=32)
        speed = np.sqrt(ug**2 + vg**2)
        ax3.contourf(xg, yg, speed, levels=20, cmap="Blues", alpha=0.6)
        ax3.streamplot(xg, yg, ug, vg, density=1.3, color="white",
                       linewidth=0.6, arrowsize=0.8)
        sm3 = plt.cm.ScalarMappable(cmap="Blues",
              norm=plt.Normalize(speed.min(), speed.max()))
        sm3.set_array([])
        if cb_handles["cb3"] is not None:
            cb_handles["cb3"].remove()
        cb_handles["cb3"] = fig.colorbar(sm3, ax=ax3, shrink=0.8, pad=0.02)
        cb_handles["cb3"].set_label("|u|/V∞", fontsize=8)
        cb_handles["cb3"].ax.tick_params(labelsize=7)
        ax3.fill(solver.x, solver.y, color="gray", alpha=0.8, zorder=5)
        ax3.plot(solver.x, solver.y, "k-", linewidth=0.8, zorder=6)
        print("fertig.")

        # ── Ax4: u_t(s) ───────────────────────────────────────
        ax4.cla()
        ax4.set_facecolor("white")
        ax4.set_title("Tangentialgeschwindigkeit u_t(s)", fontsize=10)
        ax4.set_xlabel("s/c", fontsize=9)
        ax4.set_ylabel("u_t/V∞", fontsize=9)
        ax4.grid(True, alpha=0.3, linewidth=0.5)
        s = np.cumsum(np.concatenate([[0], solver.ds]))
        s_mid = 0.5*(s[:-1]+s[1:]) / s[-1]
        ax4.plot(s_mid, ut, color="purple", linewidth=1.8)
        ax4.axhline(0, color="#aaa", linewidth=0.8, linestyle="--")
        ax4.fill_between(s_mid, ut, 0, alpha=0.12, color="purple")
        for idx in np.where(np.diff(np.sign(ut)))[0]:
            ax4.axvline(s_mid[idx], color="green", linewidth=1,
                        linestyle=":", alpha=0.7)

        fig.canvas.draw_idle()

    def on_slider(val):
        draw(sl_alpha.val)

    def on_back(event):
        plt.close(fig)
        run_generator()

    def on_sweep(event):
        run_cl_sweep(solver, name)

    sl_alpha.on_changed(on_slider)
    btn_back.on_clicked(on_back)
    btn_sweep.on_clicked(on_sweep)

    draw(alpha_init)
    plt.show()


