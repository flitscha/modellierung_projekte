# PANEL-SOLVER
# ═══════════════════════════════════════════════════════════════

class PanelSolver:
    def __init__(self, x, y):
        if np.linalg.norm([x[0]-x[-1], y[0]-y[-1]]) < 1e-10:
            x, y = x[:-1], y[:-1]
        self.x = x
        self.y = y
        self.N = len(x)
        self._build_panels()

    def _build_panels(self):
        x, y = self.x, self.y
        xn, yn = np.roll(x, -1), np.roll(y, -1)
        self.xc = 0.5*(x + xn)
        self.yc = 0.5*(y + yn)
        dx, dy = xn - x, yn - y
        self.ds = np.sqrt(dx**2 + dy**2)
        self.phi = np.arctan2(dy, dx)
        self.nx = -np.sin(self.phi)
        self.ny =  np.cos(self.phi)
        self.tx =  np.cos(self.phi)
        self.ty =  np.sin(self.phi)

    def _src(self, xi, yi, xj, yj, phi_j, ds_j):
        dx = xi - xj;  dy = yi - yj
        A =  dx*np.cos(phi_j) + dy*np.sin(phi_j)
        B = -dx*np.sin(phi_j) + dy*np.cos(phi_j)
        if abs(B) < 1e-10:
            B = 1e-10 * np.sign(B + 1e-20)
        r1 = np.sqrt(A**2 + B**2)
        r2 = np.sqrt((A - ds_j)**2 + B**2)
        t1 = np.arctan2(B, A)
        t2 = np.arctan2(B, A - ds_j)
        ux = (1/(2*np.pi))*(np.log(r1/r2)*np.cos(phi_j) + (t2-t1)*np.sin(phi_j))
        uy = (1/(2*np.pi))*(np.log(r1/r2)*np.sin(phi_j) - (t2-t1)*np.cos(phi_j))
        return ux, uy

    def _vrt(self, xi, yi, xj, yj, phi_j, ds_j):
        dx = xi - xj;  dy = yi - yj
        A =  dx*np.cos(phi_j) + dy*np.sin(phi_j)
        B = -dx*np.sin(phi_j) + dy*np.cos(phi_j)
        if abs(B) < 1e-10:
            B = 1e-10 * np.sign(B + 1e-20)
        r1 = np.sqrt(A**2 + B**2)
        r2 = np.sqrt((A - ds_j)**2 + B**2)
        t1 = np.arctan2(B, A)
        t2 = np.arctan2(B, A - ds_j)
        ux = (1/(2*np.pi))*((t2-t1)*np.cos(phi_j) + np.log(r1/r2)*np.sin(phi_j))
        uy = (1/(2*np.pi))*((t2-t1)*np.sin(phi_j) - np.log(r1/r2)*np.cos(phi_j))
        return ux, uy

    def solve(self, alpha_deg, V_inf=1.0):
        N = self.N
        alpha = np.deg2rad(alpha_deg)
        uinf = V_inf * np.array([np.cos(alpha), np.sin(alpha)])

        A_s = np.zeros((N, N))
        A_v = np.zeros(N)
        for i in range(N):
            xi, yi = self.xc[i], self.yc[i]
            nxi, nyi = self.nx[i], self.ny[i]
            for j in range(N):
                ux, uy = self._src(xi, yi, self.x[j], self.y[j], self.phi[j], self.ds[j])
                A_s[i, j] = ux*nxi + uy*nyi
                ux, uy = self._vrt(xi, yi, self.x[j], self.y[j], self.phi[j], self.ds[j])
                A_v[i] += ux*nxi + uy*nyi

        rhs = -(uinf[0]*self.nx + uinf[1]*self.ny)

        ks = np.zeros(N)
        kv = 0.0
        for j in range(N):
            ux0, uy0 = self._src(self.xc[0],  self.yc[0],  self.x[j], self.y[j], self.phi[j], self.ds[j])
            uxN, uyN = self._src(self.xc[-1], self.yc[-1], self.x[j], self.y[j], self.phi[j], self.ds[j])
            ks[j] = (ux0*self.tx[0] + uy0*self.ty[0] + uxN*self.tx[-1] + uyN*self.ty[-1])
            ux0, uy0 = self._vrt(self.xc[0],  self.yc[0],  self.x[j], self.y[j], self.phi[j], self.ds[j])
            uxN, uyN = self._vrt(self.xc[-1], self.yc[-1], self.x[j], self.y[j], self.phi[j], self.ds[j])
            kv += (ux0*self.tx[0] + uy0*self.ty[0] + uxN*self.tx[-1] + uyN*self.ty[-1])

        rhs_k = -(uinf[0]*self.tx[0] + uinf[1]*self.ty[0] +
                  uinf[0]*self.tx[-1] + uinf[1]*self.ty[-1])

        M = np.zeros((N+1, N+1))
        M[:N, :N] = A_s
        M[:N,  N] = A_v
        M[N,  :N] = ks
        M[N,   N] = kv
        sol = np.linalg.solve(M, np.append(rhs, rhs_k))
        sigma = sol[:N]
        gamma = sol[N]

        ut = np.zeros(N)
        for i in range(N):
            xi, yi = self.xc[i], self.yc[i]
            txi, tyi = self.tx[i], self.ty[i]
            ut[i] = uinf[0]*txi + uinf[1]*tyi
            for j in range(N):
                ux, uy = self._src(xi, yi, self.x[j], self.y[j], self.phi[j], self.ds[j])
                ut[i] += (ux*txi + uy*tyi)*sigma[j]
                ux, uy = self._vrt(xi, yi, self.x[j], self.y[j], self.phi[j], self.ds[j])
                ut[i] += (ux*txi + uy*tyi)*gamma

        Cp = 1.0 - (ut/V_inf)**2
        Gamma = gamma * np.sum(self.ds)
        CL = -np.sum(Cp * self.ny * self.ds)
        return sigma, gamma, Cp, CL, Gamma, ut


def velocity_field(solver, sigma, gamma, alpha_deg, V_inf=1.0, nx=50, ny=32, margin=0.3):
    alpha = np.deg2rad(alpha_deg)
    uinf = V_inf * np.array([np.cos(alpha), np.sin(alpha)])
    xg, yg = np.meshgrid(
        np.linspace(solver.x.min()-margin, solver.x.max()+margin, nx),
        np.linspace(solver.y.min()-margin, solver.y.max()+margin, ny)
    )
    ug = np.full_like(xg, uinf[0])
    vg = np.full_like(xg, uinf[1])
    for j in range(solver.N):
        for i in range(ny):
            for k in range(nx):
                xi, yi = xg[i, k], yg[i, k]
                ux, uy = solver._src(xi, yi, solver.x[j], solver.y[j], solver.phi[j], solver.ds[j])
                ug[i,k] += ux*sigma[j];  vg[i,k] += uy*sigma[j]
                ux, uy = solver._vrt(xi, yi, solver.x[j], solver.y[j], solver.phi[j], solver.ds[j])
                ug[i,k] += ux*gamma;    vg[i,k] += uy*gamma
    path = Path(np.column_stack([solver.x, solver.y]))
    mask = path.contains_points(np.column_stack([xg.ravel(), yg.ravel()])).reshape(xg.shape)
    return xg, yg, np.ma.masked_where(mask, ug), np.ma.masked_where(mask, vg)


